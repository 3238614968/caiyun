{
  "name": "caiyun-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:generate": "cd .. && python scripts/generate-openapi-local.py && python scripts/generate-asyncapi-local.py && python scripts/generate-api-client-types.py",
    "predev": "npm run contracts:generate",
    "dev": "vite",
    "prebuild": "npm run contracts:generate",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run contracts:generate",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts,.vue",
    "check:dev-proxy": "node scripts/check-dev-proxy.mjs",
    "pree2e": "npm run contracts:generate",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "audit": "npm audit --audit-level=high",
    "pretest:unit": "npm run contracts:generate",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "analyze": "npm run build && npm run analyze:report",
    "images:optimize": "node scripts/optimize-product-images.mjs",
    "analyze:report": "node scripts/analyze-bundle.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "pree2e:real": "npm run contracts:generate",
    "e2e:real": "playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.17.0",
    "dayjs": "^1.11.10",
    "element-plus": "^2.5.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "typescript": "^5.4.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^9.4.2",
    "vue-tsc": "^2.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
