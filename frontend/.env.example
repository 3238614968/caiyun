# ===========================================
# 前端 Vite 环境变量示例
# ===========================================
# 默认留空时：
# - HTTP API 使用同源相对路径 /api
# - WebSocket 使用同源相对路径 /ws
# Compose / Nginx 部署通常保持默认即可。

# 自定义 API 地址示例：http://localhost:8080
VITE_API_BASE_URL=

# 自定义 WebSocket 地址示例：ws://localhost:8080/ws
# 百度云普通 CDN 不支持 WebSocket 时，可使用未接入 CDN 的独立源站子域：
# VITE_WS_URL=wss://ws.example.com/ws
VITE_WS_URL=

# 实时推送传输：sse（默认，适合 CDN）、ws、auto（优先 WS，失败回退 SSE）
VITE_PUSH_TRANSPORT=sse
# SSE 地址默认同源 /events
VITE_SSE_URL=
