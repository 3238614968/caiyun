package handlers

import (
	"caiyun/internal/monitor"
	"net/http"

	"github.com/gin-gonic/gin"
)

// queueLengthProvider 定义队列长度读取接口，便于复用 Redis 缓存实现。
type queueLengthProvider interface {
	LLen(key string) int64
}

// QueueStatusHandler 负责返回任务队列与任务监控统计信息。
type QueueStatusHandler struct {
	redisCache queueLengthProvider
}

// NewQueueStatusHandler 创建队列状态处理器。
func NewQueueStatusHandler(redisCache queueLengthProvider) *QueueStatusHandler {
	return &QueueStatusHandler{redisCache: redisCache}
}

// GetQueueStatus 获取队列状态与监控统计。
func (h *QueueStatusHandler) GetQueueStatus(c *gin.Context) {
	var queueLength int64
	if h.redisCache != nil {
		queueLength = h.redisCache.LLen("task:queue:pending")
	}

	activeWorkers := int32(0)
	completedTasks := int32(0)
	successfulTasks := int32(0)
	failedTasks := int32(0)

	if tm := monitor.GetGlobalTaskMonitor(); tm != nil {
		stats := tm.GetStats()
		activeWorkers = toInt32(stats["active_tasks"])
		completedTasks = toInt32(stats["completed_tasks"])
		successfulTasks = toInt32(stats["successful"])
		failedTasks = toInt32(stats["failed"])
	}

	c.JSON(http.StatusOK, QueueStatusResponse{
		QueueLength:     queueLength,
		ActiveWorkers:   activeWorkers,
		PendingTasks:    int(queueLength),
		CompletedTasks:  completedTasks,
		SuccessfulTasks: successfulTasks,
		FailedTasks:     failedTasks,
	})
}

// toInt32 将监控统计中的通用数值类型转换为 int32。
func toInt32(value interface{}) int32 {
	switch v := value.(type) {
	case int:
		return int32(v)
	case int32:
		return v
	case int64:
		return int32(v)
	case float64:
		return int32(v)
	default:
		return 0
	}
}

