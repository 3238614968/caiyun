# ===========================================
# 移动云盘后端环境变量示例文件
# ===========================================
# 使用说明：
# 1. 复制本文件到 backend/.env（或按你的启动脚本指定路径）
# 2. 根据实际环境修改配置值
# 3. 不要提交真实 .env 到 Git（已在 .gitignore 中忽略）

# ===========================================
# 服务配置
# ===========================================
# API 服务监听端口
PORT=8080

# Worker 监控 HTTP 服务端口（/health、/status、/metrics）
WORKER_MONITOR_PORT=8081

# 兼容旧配置名（当前主程序不读取，可删除）
WORKER_PORT=8081

# 运行模式：debug / release / test
GIN_MODE=release

# ===========================================
# MySQL 数据库配置
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=caiyun

# 连接池配置（如代码未使用，可作为预留）
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=1h

# ===========================================
# Redis 配置
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ===========================================
# JWT 配置
# ===========================================
# 生产环境请替换为至少 32 位随机字符串
JWT_SECRET=your_32_character_random_secret_here
JWT_EXPIRY=720
JWT_REFRESH_EXPIRY=2160

# ===========================================
# 任务系统配置
# ===========================================
TASK_CONCURRENCY=5
TASK_SCHEDULE=0 2 * * *
ENABLE_SIGN_IN=true
ENABLE_CLOUD_REWARD=true

# ===========================================
# 兑换中心配置
# ===========================================
EXCHANGE_CONCURRENCY=5
EXCHANGE_SCHEDULE_TIME_1=10:00
EXCHANGE_SCHEDULE_TIME_2=20:00
EXCHANGE_AUTO_UPDATE_PRODUCTS=true
EXCHANGE_UPDATE_TIME=6
EXCHANGE_ENABLED=true

# ===========================================
# 短信服务配置（按需启用）
# ===========================================
# 短信服务提供商：aliyun / tencent / unicom
SMS_PROVIDER=unicom
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_SIGN=移动云盘
SMS_RATE_LIMIT_DURATION=300
SMS_RATE_LIMIT_COUNT=1

# 彩云短信登录服务地址
CAIYUN_SMS_API_BASE_URL=https://ydyp.apisky.cn

# 彩云短信登录服务 Token（优先读取 CAIYUN_SMS_API_TOKEN，未设置时回退 DEFAULT_API_TOKEN）
CAIYUN_SMS_API_TOKEN=
DEFAULT_API_TOKEN=

# 是否跳过短信接口 TLS 证书校验（仅调试时可设为 true，生产环境必须为 false）
CAIYUN_SMS_INSECURE_SKIP_VERIFY=false

# ===========================================
# 彩云认证（配置文件 auth 为空时回退读取）
# ===========================================
CAIYUN_AUTH=

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=7
LOG_COMPRESS=true

# ===========================================
# 监控与告警配置
# ===========================================
PROMETHEUS_PORT=9090
ENABLE_MONITORING=true
ALERT_NOTIFICATION=email
ALERT_CPU_THRESHOLD=80
ALERT_MEMORY_THRESHOLD=85
ALERT_DISK_THRESHOLD=90

# ===========================================
# WebSocket 配置
# ===========================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=10240

# ===========================================
# 其他配置
# ===========================================
ENABLE_SWAGGER=true
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://yourdomain.com
REQUEST_TIMEOUT=30
MAX_UPLOAD_SIZE=50
