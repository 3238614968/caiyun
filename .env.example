# ===========================================
# Docker Compose 环境变量示例
# ===========================================
# 使用方式：
#   cp .env.example .env
#   按实际部署环境修改强密码、域名和 SMTP 配置
#
# 注意：
# - docker-compose.yml 会自动读取项目根目录 .env
# - 不要提交真实 .env
# - 所有密码/密钥请使用强随机值

# ===========================================
# 运行环境
# ===========================================
# production 会启用生产安全配置强校验，缺少必需密钥时服务拒绝启动。
APP_ENV=production
# 生产环境必须为 true；仅本地 HTTP 调试可设为 false。
COOKIE_SECURE=true
# Compose 默认只绑定本机；公网部署应由宿主机 HTTPS 反向代理转发。
CAIYUN_BIND_ADDRESS=127.0.0.1
CAIYUN_HTTP_PORT=80
CAIYUN_BACKEND_IMAGE=caiyun-backend:local
CAIYUN_GOPROXY=https://goproxy.cn,direct
CAIYUN_API_PORT=8080
CAIYUN_WORKER_PORT=8081

# ===========================================
# MySQL
# ===========================================
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_USER=caiyun_app
MYSQL_PASSWORD=replace_with_strong_app_password
# 生产环境的 API/Worker 禁止自动迁移；发布时先运行同版本后端的专用 migrator。
# 仅非生产本地开发可按需设为 true。
DB_AUTO_MIGRATE=false
# API/Worker 默认不写任务定义；发布期由 `caiyun migrate` 同步。
TASK_CONFIG_SYNC_ON_STARTUP=false

# ===========================================
# Redis
# ===========================================
REDIS_PASSWORD=replace_with_strong_redis_password
# 多副本 API 必须共享 Redis 限流状态；生产环境不允许 memory。
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_WINDOW=1s

# 数据库存储中的 auth/token/jwt_token 字段使用 AES-GCM-256 加密。
# APP_ENV=production 时以下两个配置均为必填；当前版本必须存在于版本化密钥环中。
DATA_ENCRYPTION_KEYS=v1=__GENERATE_32_BYTE_RANDOM_DATA_KEY__
DATA_ENCRYPTION_CURRENT_VERSION=v1
# 新版密文使用 AAD。保留旧版无 AAD 密文时可设为 true 并保留原密钥；新部署或完成重加密后设为 false。
FIELD_CRYPTO_ALLOW_LEGACY_NO_AAD=false
# 仅非生产环境兼容旧部署；生产环境不能用它替代 DATA_ENCRYPTION_KEYS。
# DATA_ENCRYPTION_KEY=__LEGACY_32_BYTE_DATA_KEY__

# ===========================================
# 任务队列
# ===========================================
# list：默认 Redis List 可靠队列；streams：Redis Streams consumer group 队列。
TASK_QUEUE_BACKEND=streams
TASK_QUEUE_STREAM_GROUP=caiyun-workers
TASK_CONCURRENCY=10
TASK_SCHEDULE=0 8 * * *
# 同一用户下活跃云盘账号的 139 邮箱互发：每个有序账号对每月最多一次。
# 单次执行的最大发信数；账号很多时会在后续批次继续。
CAIYUN_MAIL_MUTUAL_MAX_SENDS_PER_RUN=20
# 全网抽抽乐：默认每批3次、间隔1500毫秒；设次数为0可跳过。
CAIYUN_TASK_SHAKE_TIMES=3
CAIYUN_TASK_SHAKE_DELAY_MS=1500
# Authorization 提前续期窗口（小时）。凭据在到期前该时长内自动轮换，
# 避免每月凭据到期日（各账号多为 20 几号）硬过期后 refreshToken 被拒、
# 连续失败导致账号自动停用。轮换会使手机端旧凭据失效（单活凭据）；
# 需要保留手机登录时设为 0（回到旧的到期后刷新行为）。默认 72。
CAIYUN_AUTH_REFRESH_LEAD_HOURS=72
# 中国移动权益市场（coc3）0元抽奖提交端点必带的 wasm 令牌。
# 令牌与账号无关但有时效性；由纯 Go 运行时直接执行内置 wheel_bg.wasm，
# 每轮按需现生成，无需 Node.js、浏览器、CGO 或外部资源文件。
# CAIYUN_COC3_WASM_DIR 可覆盖 wheel_bg.wasm，用于官方资源升级。
# CAIYUN_COC3_WASM_PARAMS 保留为显式静态覆盖（可能随时效失效，一般留空即可）。
# 生成失败会保留原因并标记待确认，不会未经确认就显示抽奖成功。
# CAIYUN_COC3_WASM_DIR=/opt/caiyun/wheel
# CAIYUN_COC3_WASM_PARAMS=
# COC3 设备风控字段按账号提供；只在抽奖提交时携带，触发风控即停。
# CAIYUN_COC3_RISK_TOKEN_13800000001=
# CAIYUN_COC3_DEVICE_ID_13800000001=
# 通用任务进度默认使用服务端当期任务ID，不再固定查询已失效的3040/3041/3026。
# CAIYUN_COC3_TASK_IDS_13800000001=3097,3098,3100
# 一豆赢惊喜：显式启用才会扣权益豆；单轮默认1次，上限5次。
# CAIYUN_COC3_BEAN_DRAW_13800000001=true
# CAIYUN_COC3_BEAN_MAX_DRAWS_13800000001=1
# Web6 网龄评价使用账号提供的真实内容；不配置则保留待办。
# 评价标签为对应星级的页面标签编号（5星为21~25，4星为16~20）。
# CAIYUN_COC_WEB6_EVALUATION_JSON_13800000001={"score":4,"label":"16,17","content":""}
# CAIYUN_COC_WEB6_PROVINCE_CODE_13800000001=100
# 按账号任务配置：变量名 + "_" + 手机号，未配置时使用任务内默认值或跳过。
# 年度账单问卷答案（可选，默认 reasonChoice=A、suggestChoice=A）。
# CAIYUN_BILL_FEEDBACK_JSON_13800000001={"reasonChoice":"B","suggestChoice":"C"}
# APP 通知真实状态 0/1；不配置则不代为上报，551/1021 不会开始累计。
# CAIYUN_APP_NOTICE_STATUS_13800000001=1
# 活动兑换码，多个用逗号分隔。
# CAIYUN_REDEEM_CODES_13800000001=ABC123,DEF456
# 领奖专区单个奖品：OID 与已收到的短信验证码必须成对提供。
# CAIYUN_PRIZE_OID_13800000001=1273414545
# CAIYUN_PRIZE_SMS_CODE_13800000001=123456
# 抢兑默认本地识别，无需短信识别服务；remote 可显式切回原来的远端识别。
CAIYUN_EXCHANGE_SLIDE_SOLVER=builtin
# 抢兑滑块识别最低置信度；较低结果重新取题，最多3题，不提交低置信度坐标。
CAIYUN_EXCHANGE_SLIDE_MIN_CONFIDENCE=0.75
TASK_QUEUE_STREAM_MAXLEN=100000
# running 抢兑任务超时恢复阈值；支持 15m / 900 这两种写法。
EXCHANGE_TASK_RUNNING_TIMEOUT=15m
# 抢兑请求平滑限流与短时幂等保护。
# 整点抢兑要在 12:00:00 瞬间把整波账号一起发出，rate/burst 过低会把
# 20~30 个账号摊到 3~5 秒而抢不到货；真正的并发由调度器 concurrency
# 令牌桶与每账号+商品提交锁兜底。若上游触发风控/滑块可适当下调。
EXCHANGE_REQUEST_PACING_ENABLED=true
EXCHANGE_REQUESTS_PER_SECOND=30
EXCHANGE_REQUEST_BURST=30
EXCHANGE_SUBMIT_LOCK_TTL=5s
# 整点精确触发的时钟纠偏量（正=延后发，负=提前发，限 ±5s，默认 0）。
# 运行 backend 的 TestExchangeLatencyProbe（CAIYUN_EXCHANGE_PROBE=1）可测出
# 本机与服务端的时钟偏差：若本机快约 1.2s，设 EXCHANGE_FIRE_OFFSET=1200ms
# 以免过早请求被判“未开始”；更推荐直接 NTP 校时。
EXCHANGE_FIRE_OFFSET=0

# 历史日志/抢兑记录冷热归档脚本参数（scripts/archive-history.sh）
TZ=Asia/Shanghai
ARCHIVE_TASK_LOGS_BEFORE_DAYS=90
ARCHIVE_EXCHANGE_RECORDS_BEFORE_DAYS=180
ARCHIVE_BATCH_SIZE=1000


# ===========================================
# JWT / 会话
# ===========================================
JWT_SECRET=replace_with_32_chars_random_secret
JWT_ISSUER=caiyun-api
JWT_AUDIENCE=caiyun-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# API/Worker 启动时会校验应用、MySQL、Redis 时钟；偏差超过此值会拒绝启动。
CLOCK_SKEW_MAX=30s

# ===========================================
# 首次管理员（仅 backend-admin-init 使用，不注入 API/Worker）
# ===========================================
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_admin_password
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# 逗号分隔；必须包含浏览器实际访问前端的完整 Origin（协议 + 域名/IP + 端口）
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Compose 留空时只信任下方 frontend 固定 IP；直接运行后端可设 none。
# K8s 必须填写实际 frontend/Ingress 来源 IP/CIDR，禁止 0.0.0.0/0。
TRUSTED_PROXIES=
CAIYUN_DOCKER_SUBNET=172.30.139.0/24
CAIYUN_DOCKER_GATEWAY=172.30.139.1
# 动态容器地址必须避开下方 frontend 固定 IP。
CAIYUN_DOCKER_DYNAMIC_RANGE=172.30.139.128/25
CAIYUN_FRONTEND_IP=172.30.139.10
# 外层代理到 frontend 的可信来源；留空时 Compose 只信任本机 bridge 网关。
TRUSTED_INGRESS_PROXIES=

# 容器日志输出到 stdout，由 Docker/Kubernetes 日志驱动统一采集。
LOG_FILE_PATH=
LOG_JSON_FORMAT=true

# ===========================================
# OpenTelemetry（可选）
# ===========================================
# 设为 true 后，API、Worker、GORM、Redis、上游 HTTP 与队列消费会通过
# OTLP/gRPC 发送 Span。生产默认采样率建议 0.10；开发环境可设为 1。
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_EXPORTER_OTLP_CERTIFICATE=
OTEL_SAMPLE_RATIO=0.10

# WebSocket 跨实例事件总线与至少一次投递参数。
WS_EVENT_CHANNEL=caiyun:ws:events
WS_MESSAGE_TTL=24h
WS_ACK_TIMEOUT=5s
WS_MAX_RETRIES=3
# CDN 对无数据的 SSE 分块连接有较短超时时，使用 3 秒心跳保持连接。
SSE_HEARTBEAT_INTERVAL=3s

# ===========================================
# Worker 监控
# ===========================================
API_MONITOR_TOKEN=replace_with_random_api_monitor_token
WORKER_MONITOR_TOKEN=replace_with_random_monitor_token
WORKER_MONITOR_HOST=0.0.0.0
WORKER_MONITOR_PORT=8081
WORKER_MONITOR_ALLOW_PLAINTEXT=true

# ===========================================
# Grafana
# ===========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password

# ===========================================
# 邮箱服务（可选，用于密码找回验证码）
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=移动云盘
# 465 用 true（隐式 TLS）；587 用 false（强制 STARTTLS）。两种模式均禁止明文发送。
SMTP_USE_TLS=false

# 咪咕音乐活动：复用账号现有云盘 Authorization 自动换票，金币/音符独立记录。
# 任务由原有任务配置控制，发布时执行 caiyun migrate 同步新增定义。
# 饭点、晚安独立定时从北京时间12:00、22:00开始，窗口内每20分钟补查并按天去重。
# 两项定时随Worker启动注册，沿用migu_noon/migu_night的任务开关与日志格式。
CAIYUN_MIGU_ACTIVITY_ID=MAC_KF_CBH_JBZX
# 按参考协议补报的目标时长（0–30分钟）；0表示只领取已达标的听歌奖励。
CAIYUN_MIGU_SONG_MINUTES=30
# 可选账号设备信息：变量名后缀换成该账号手机号；同账号跨批次保持一致。
# 不配置时设备ID按账号稳定生成，IP字段使用127.0.0.1。
# CAIYUN_MIGU_DEVICE_ID_13800000000=0123456789abcdef
# CAIYUN_MIGU_IP_13800000000=192.0.2.10
