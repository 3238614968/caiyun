# ===========================================
# Docker Compose 环境变量示例
# ===========================================
# 使用方式：
#   cp .env.example .env
#   按实际部署环境修改强密码、域名和 SMTP 配置
#
# 注意：
# - docker-compose.yml 会自动读取项目根目录 .env
# - 不要提交真实 .env
# - 所有密码/密钥请使用强随机值

# ===========================================
# 运行环境
# ===========================================
# production 会启用生产安全配置强校验，缺少必需密钥时服务拒绝启动。
APP_ENV=production
# 生产环境必须为 true；仅本地 HTTP 调试可设为 false。
COOKIE_SECURE=true

# ===========================================
# MySQL
# ===========================================
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_USER=caiyun_app
MYSQL_PASSWORD=replace_with_strong_app_password
# 生产环境的 API/Worker 禁止自动迁移；发布时先运行同版本后端的专用 migrator。
# 仅非生产本地开发可按需设为 true。
DB_AUTO_MIGRATE=false
# API/Worker 默认不写任务定义；发布期由 `caiyun migrate` 同步。
TASK_CONFIG_SYNC_ON_STARTUP=false

# ===========================================
# Redis
# ===========================================
REDIS_PASSWORD=replace_with_strong_redis_password
# 多副本 API 必须共享 Redis 限流状态；生产环境不允许 memory。
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_WINDOW=1s

# 数据库存储中的 auth/token/jwt_token 字段使用 AES-GCM-256 加密。
# APP_ENV=production 时以下两个配置均为必填；当前版本必须存在于版本化密钥环中。
DATA_ENCRYPTION_KEYS=v1=__GENERATE_32_BYTE_RANDOM_DATA_KEY__
DATA_ENCRYPTION_CURRENT_VERSION=v1
# 新版密文使用 AAD。旧版无 AAD 密文的重加密窗口才临时设为 true；完成后保持 false。
FIELD_CRYPTO_ALLOW_LEGACY_NO_AAD=false
# 仅非生产环境兼容旧部署；生产环境不能用它替代 DATA_ENCRYPTION_KEYS。
# DATA_ENCRYPTION_KEY=__LEGACY_32_BYTE_DATA_KEY__

# ===========================================
# 任务队列
# ===========================================
# list：默认 Redis List 可靠队列；streams：Redis Streams consumer group 队列。
TASK_QUEUE_BACKEND=streams
TASK_QUEUE_STREAM_GROUP=caiyun-workers
TASK_QUEUE_STREAM_MAXLEN=100000
# running 抢兑任务超时恢复阈值；支持 15m / 900 这两种写法。
EXCHANGE_TASK_RUNNING_TIMEOUT=15m
# 抢兑请求平滑限流与短时幂等保护
EXCHANGE_REQUEST_PACING_ENABLED=true
EXCHANGE_REQUESTS_PER_SECOND=6
EXCHANGE_REQUEST_BURST=2
EXCHANGE_SUBMIT_LOCK_TTL=5s

# 历史日志/抢兑记录冷热归档脚本参数（scripts/archive-history.sh）
TZ=Asia/Shanghai
ARCHIVE_TASK_LOGS_BEFORE_DAYS=90
ARCHIVE_EXCHANGE_RECORDS_BEFORE_DAYS=180
ARCHIVE_BATCH_SIZE=1000


# ===========================================
# JWT / 会话
# ===========================================
JWT_SECRET=replace_with_32_chars_random_secret
JWT_ISSUER=caiyun-api
JWT_AUDIENCE=caiyun-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# API/Worker 启动时会校验应用、MySQL、Redis 时钟；偏差超过此值会拒绝启动。
CLOCK_SKEW_MAX=30s

# 逗号分隔；必须包含浏览器实际访问前端的完整 Origin（协议 + 域名/IP + 端口）
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# 直连部署设为 none；经反向代理时仅填写实际代理 IP/CIDR，禁止 0.0.0.0/0。
TRUSTED_PROXIES=none

# 容器日志输出到 stdout，由 Docker/Kubernetes 日志驱动统一采集。
LOG_FILE_PATH=
LOG_JSON_FORMAT=true

# ===========================================
# OpenTelemetry（可选）
# ===========================================
# 设为 true 后，API、Worker、GORM、Redis、上游 HTTP 与队列消费会通过
# OTLP/gRPC 发送 Span。生产默认采样率建议 0.10；开发环境可设为 1。
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_EXPORTER_OTLP_CERTIFICATE=
OTEL_SAMPLE_RATIO=0.10

# WebSocket 跨实例事件总线与至少一次投递参数。
WS_EVENT_CHANNEL=caiyun:ws:events
WS_MESSAGE_TTL=24h
WS_ACK_TIMEOUT=5s
WS_MAX_RETRIES=3
# CDN 对无数据的 SSE 分块连接有较短超时时，使用 3 秒心跳保持连接。
SSE_HEARTBEAT_INTERVAL=3s

# ===========================================
# Worker 监控
# ===========================================
API_MONITOR_TOKEN=replace_with_random_api_monitor_token
WORKER_MONITOR_TOKEN=replace_with_random_monitor_token
WORKER_MONITOR_HOST=0.0.0.0
WORKER_MONITOR_PORT=8081
WORKER_MONITOR_ALLOW_PLAINTEXT=true

# ===========================================
# Grafana
# ===========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password

# ===========================================
# 邮箱服务（可选，用于密码找回验证码）
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=移动云盘
# 465 端口通常设为 true；587 端口通常设为 false 并由 SMTP STARTTLS 升级
SMTP_USE_TLS=false
